/* mc dashboard styles */

Screen {
    background: $background;
}
* {
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    scrollbar-color: $primary 45%;
    scrollbar-color-hover: $primary 75%;
    scrollbar-color-active: $primary;
}
Screen .screen--selection {
    background: $accent 45%;
    color: $text;
}
Header {
    background: $panel;
    color: $primary;
    text-style: bold;
}
Footer {
    background: $panel;
}
Footer .footer-key--key {
    color: $accent;
    background: transparent;
    text-style: bold;
}
Footer .footer-key--description {
    color: $text-muted;
}
Tabs {
    background: $background;
}
Tab {
    padding: 0 1;
    color: $text-muted;
}
Tab.-active {
    color: $primary;
    text-style: bold;
}
Tabs:focus Tab.-active {
    color: $primary;
    background: transparent;
}
Tab:hover {
    color: $text;
}
Tabs .underline--bar {
    color: $primary;
    background: $primary 20%;
}
Button {
    min-width: 12;
    border: none;
    height: 3;
    padding: 0 2;
    content-align: center middle;
    text-style: bold;
}
Button {
}
Button:hover {
    text-style: bold reverse;
}
Button:disabled {
    opacity: 50%;
}
Input {
    border: tall $primary 25%;
    background: $surface;
}
Input:focus {
    border: tall $primary;
}
Select > SelectCurrent {
    border: tall $primary 25%;
    background: $surface;
}
Switch {
    border: tall $primary 25%;
    background: $surface;
}
Switch.-on .switch--slider {
    color: $success;
}
DataTable > .datatable--header {
    background: $panel;
    color: $accent;
    text-style: bold;
}
DataTable > .datatable--cursor {
    background: $primary 35%;
    color: $text;
    text-style: bold;
}
DataTable > .datatable--even-row {
    background: $surface;
}
DataTable {
    background: $background;
    border: round $primary 25%;
}
Toast {
    border-left: thick $primary;
    background: $panel;
}
Toast.-information .toast--title { color: $primary; }
Toast.-warning .toast--title { color: $warning; }
Toast.-error .toast--title { color: $error; }

#body {
    height: 1fr;
}

/* ---------- sidebar ---------- */
#sidebar {
    width: 30;
    border-right: tall $primary 25%;
    background: $surface;
}
.sidebar-title {
    padding: 1 2 1 2;
    color: $primary;
    text-style: bold;
}
#server-list {
    height: 1fr;
    background: $surface;
}
#server-list > ListItem {
    padding: 0 1;
    height: 3;
    background: $surface;
    border-left: blank;
    color: $text;
}
#server-list > ListItem:hover {
    background: $primary 12%;
    color: $text;
}
#server-list > ListItem.-highlight {
    background: $primary 16%;
    border-left: thick $primary;
    color: $text;
}
#server-list:focus > ListItem.-highlight {
    background: $primary 24%;
    color: $text;
}
.sidebar-help {
    padding: 0 2 1 2;
    color: $text-muted;
    border-top: hkey $primary 25%;
}

#cat {
    height: 6;
    padding: 1 2 0 2;
    border-top: hkey $primary 25%;
}

/* ---------- narrow terminals ---------- */
Screen.-narrow #sidebar {
    width: 22;
}
Screen.-narrow .tiles {
    layout: grid;
    grid-size: 2;
    grid-gutter: 0 1;
    height: 11;
}
Screen.-narrow .tile {
    margin-right: 0;
}

/* ---------- common ---------- */
#tabs {
    width: 1fr;
}
TabPane {
    padding: 1 2;
}
.section-title {
    margin-top: 1;
    color: $accent;
    text-style: bold;
    width: 100%;
    border-bottom: hkey $accent 25%;
}
.card {
    border: round $primary 60%;
    background: $panel;
    padding: 1 2;
    height: auto;
}
.section {
    border: round $primary 45%;
    border-title-color: $accent;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    background: $panel;
    padding: 0 2 1 2;
    margin-top: 1;
    height: auto;
}
.section-online {
    border: round $success 85%;
}
.section-file {
    border: dashed $warning 70%;
}
.section > .buttons:first-child, .section > .inline-form:first-child {
    margin-top: 1;
}
.buttons {
    height: auto;
    margin: 1 0 0 0;
}
.buttons Button {
    margin-right: 1;
    min-width: 10;
}
.inline-form {
    height: auto;
    margin-top: 1;
}
.inline-form Input {
    width: 1fr;
}
.inline-form Button {
    margin-left: 1;
}
.hint {
    color: $text-muted;
    margin-top: 1;
}
.error {
    color: $error;
}
DataTable {
    height: auto;
    max-height: 16;
}

/* ---------- overview ---------- */
#ov-events {
    height: 9;
    border: round $primary 30%;
    background: $surface;
    padding: 0 1;
}
.banner.alert {
    background: $error 25%;
}
#ov-fleet {
    max-height: 10;
}
#activity {
    height: 9;
    border: round $primary 30%;
    background: $surface;
    padding: 0 1;
}

/* ---------- resources ---------- */
.panel {
    border: round $primary 50%;
    border-title-color: $accent;
    border-title-style: bold;
    background: $panel;
    padding: 1 2;
    height: auto;
    margin-bottom: 1;
}
.sub-title {
    margin-top: 1;
    color: $accent;
    text-style: bold;
}
.range-row {
    height: 3;
    margin-bottom: 1;
}
.range-label {
    padding: 1 1 0 0;
    color: $text-muted;
}
.range-row Button {
    min-width: 14;
    margin-right: 1;
    background: $surface;
    color: $text-muted;
}
.range-row Button.active {
    background: $primary 30%;
    color: $text;
    text-style: bold;
}
.tiles {
    height: 5;
    margin-bottom: 1;
}
.tile {
    width: 1fr;
    height: 5;
    border: round $primary 35%;
    border-title-color: $accent;
    border-title-style: bold;
    background: $surface;
    padding: 0 1;
    margin-right: 1;
}
.tiles > .tile:last-child {
    margin-right: 0;
}
.spark-label {
    color: $text;
}
#res-cores, #res-share, #res-server {
    margin-bottom: 1;
}
.sparks {
    height: auto;
    margin-top: 1;
}
.sparks > Vertical {
    width: 1fr;
    height: auto;
    margin-right: 2;
}
Sparkline {
    height: 2;
}
.heat {
    height: 2;
    width: 1fr;
}
Sparkline > .sparkline--max-color {
    color: $primary;
}
Sparkline > .sparkline--min-color {
    color: $primary 30%;
}
#res-servers {
    max-height: 12;
}

/* ---------- console ---------- */
#console-bar, #console-quick {
    height: 3;
}
#console-filter {
    width: 1fr;
    margin-right: 1;
}
Button.chip {
    min-width: 8;
    margin-right: 1;
    background: $surface;
    color: $text-muted;
}
Button.chip.active {
    background: $primary 30%;
    color: $text;
    text-style: bold;
}
#console-quick {
    margin-top: 1;
}
#console-log {
    height: 1fr;
    border: round $primary 40%;
    background: $surface;
    padding: 0 1;
}
#console-input {
    margin-top: 1;
}

/* ---------- players ---------- */
#pl-table {
    max-height: 20;
}

/* ---------- settings ---------- */
.banner {
    display: none;
    height: auto;
    background: $warning 25%;
    padding: 0 1;
    margin-top: 1;
}
.banner.show {
    display: block;
}
#restart-banner {
    display: none;
    height: auto;
    background: $warning 25%;
    padding: 0 1;
    margin-bottom: 1;
}
#restart-banner.show {
    display: block;
}
.banner-text {
    width: 1fr;
    content-align: left middle;
    height: 3;
}
#settings-form {
    height: 1fr;
}
.setting-row {
    height: auto;
    min-height: 3;
    margin-bottom: 0;
}
.setting-label {
    width: 44;
    height: auto;
    padding: 0 1 0 0;
    content-align: left middle;
}
.setting-control {
    width: 32;
    height: auto;
}
.setting-control Input, .setting-control Select {
    width: 30;
}
.setting-tag {
    width: 10;
    padding: 1 0 0 1;
    color: $text-muted;
}
.setting-tag.live {
    color: $success;
}
.setting-tag.restart {
    color: $warning;
}

/* ---------- mods ---------- */
#mods-table {
    max-height: 12;
}
#mods-results {
    max-height: 12;
}

/* ---------- dialogs ---------- */
Confirm, NewServer, TextResult {
    align: center middle;
}
.dialog {
    width: 60;
    height: auto;
    border: round $primary;
    background: $panel;
    padding: 1 3;
}
.dialog.wide {
    width: 84;
}
.dialog.tall {
    height: 80%;
}
#new-scroll {
    height: auto;
    max-height: 72vh;
}
#new-scroll Collapsible {
    margin-top: 1;
    padding: 0;
    border-top: none;
}
#loader-hint {
    margin: 1 0 0 0;
}
.dialog-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}
.dialog-buttons {
    height: auto;
    margin-top: 1;
}
.dialog-buttons Button {
    margin-right: 1;
}
.form-grid {
    grid-size: 2;
    grid-columns: 26 1fr;
    grid-rows: auto;
    grid-gutter: 1 1;
    height: auto;
}
.form-grid Label {
    padding-top: 1;
}

/* ---------- status bar (always visible) ---------- */
#main {
    width: 1fr;
}
#statusbar {
    height: 1;
    padding: 0 2;
    background: $panel;
}

/* ---------- files ---------- */
#files-body {
    height: 1fr;
}
#files-left {
    width: 40%;
    min-width: 30;
    margin-right: 1;
}
#files-tree {
    height: 1fr;
    border: round $primary 30%;
}
#files-actions {
    height: auto;
}
#files-actions Button {
    width: 100%;
    margin-top: 1;
}
#files-right {
    width: 1fr;
}
#files-editor {
    height: 1fr;
    border: round $primary 40%;
    background: $surface;
}
#files-status {
    height: auto;
    margin-top: 0;
}

/* ---------- game / network ---------- */
#gm-out, #gm-feed {
    height: 8;
    border: round $primary 30%;
    background: $surface;
    padding: 0 1;
}
#gm-border, #gm-coords, #gm-item {
    width: 1fr;
}
#gm-count {
    width: 8;
}
.inline-form Select {
    width: 1fr;
}

/* ---------- picker dialog ---------- */
#picker-tree {
    height: 1fr;
    min-height: 10;
    border: round $primary 30%;
}
